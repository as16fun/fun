{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story.schema.json",
  "title": "Storyline story",
  "description": "One file drives the whole map: story metadata, chapters, sources and events. Coordinates are WGS84 [lon, lat]. Times are \"HH:MM\" local to story.timezone, or full ISO 8601 timestamps with an offset.",
  "type": "object",
  "required": ["story", "chapters", "events"],
  "$defs": {
    "time": {
      "type": "string",
      "description": "\"HH:MM\" (local wall-clock time on story.date) or an ISO 8601 timestamp with offset.",
      "pattern": "^(\\d{1,2}:\\d{2}(:\\d{2})?|\\d{4}-\\d{2}-\\d{2}T.+)$"
    },
    "lonlat": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -90, "maximum": 90 }]
    },
    "line": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/lonlat" } },
    "location": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["point", "path", "paths", "area", "Point", "LineString", "MultiLineString", "Polygon"] },
        "coordinates": {
          "description": "point: [lon, lat]; path: [[lon, lat], …]; paths: [[[lon, lat], …], …]; area: a ring [[lon, lat], …]."
        },
        "anchor": { "$ref": "#/$defs/lonlat", "description": "Where the numbered pin stands. Defaults to the linked building's roof, the point, the start of a path or the centre of an area." },
        "width": { "type": "number", "description": "Closures: width of the closed road band in metres (default 12)." },
        "snap": { "enum": ["streets", "bus", "tram"], "description": "Authoring only: `npm run snap-paths` routes `via` waypoints over OSM streets or tram tracks and fills `coordinates`." },
        "via": { "description": "Authoring only: waypoints for `snap`." },
        "fromOsm": { "type": "string", "description": "Authoring only: copy an OSM area outline (e.g. \"w37746636\") into `coordinates` with `npm run snap-paths`." }
      }
    },
    "crowdValue": {
      "type": "object",
      "required": ["estimate"],
      "properties": {
        "estimate": { "type": "number", "minimum": 0 },
        "low": { "type": "number", "minimum": 0 },
        "high": { "type": "number", "minimum": 0 }
      }
    }
  },
  "properties": {
    "story": {
      "type": "object",
      "required": ["title", "date", "timezone", "start", "end"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "standfirst": { "type": "string" },
        "byline": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "timezone": { "type": "string", "description": "IANA zone, e.g. Europe/Amsterdam" },
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time" },
        "place": { "type": "string" },
        "fictional": { "type": "boolean" },
        "disclaimer": { "type": "string" }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "start"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "start": { "$ref": "#/$defs/time" },
          "summary": { "type": "string" },
          "camera": {
            "type": "object",
            "properties": {
              "target": { "$ref": "#/$defs/lonlat" },
              "zoom": { "type": "number", "description": "Relative: 1 = whole district, 2 = twice as close." },
              "bearing": { "type": "number" },
              "pitch": { "type": "number" }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "Registry of sources; events cite them by id and add a timestamp.",
      "items": {
        "type": "object",
        "required": ["id", "name", "type"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "enum": ["reporter", "photo", "video", "data", "official", "organiser", "organisation", "eyewitness", "social"] },
          "reliability": { "enum": ["high", "medium", "low"] },
          "note": { "type": "string" },
          "link": { "type": "string" }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["id", "time", "title", "type", "location", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "time": {
            "oneOf": [
              { "$ref": "#/$defs/time" },
              { "type": "object", "required": ["start"], "properties": { "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" } } }
            ]
          },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "type": { "enum": ["gathering", "movement", "closure", "transport", "statement", "incident"] },
          "place": { "type": "string", "description": "Short human-readable location label." },
          "location": { "$ref": "#/$defs/location" },
          "buildingId": { "type": "string", "description": "OSM id from buildings.geojson, e.g. \"w58617251\"." },
          "buildingIds": { "type": "array", "items": { "type": "string" } },
          "crowd": {
            "allOf": [{ "$ref": "#/$defs/crowdValue" }],
            "properties": {
              "series": {
                "type": "array",
                "description": "Keyframes; values are interpolated linearly in time.",
                "items": { "allOf": [{ "$ref": "#/$defs/crowdValue" }], "required": ["time"], "properties": { "time": { "$ref": "#/$defs/time" } } }
              },
              "claims": {
                "type": "array",
                "description": "Competing figures shown on disputed events.",
                "items": { "type": "object", "required": ["source", "estimate"], "properties": { "source": { "type": "string" }, "estimate": { "type": "number" }, "timestamp": { "$ref": "#/$defs/time" } } }
              }
            }
          },
          "confidence": { "enum": ["confirmed", "reported", "unverified", "disputed"] },
          "confidenceNote": { "type": "string" },
          "quote": { "type": "object", "properties": { "text": { "type": "string" }, "attribution": { "type": "string" } } },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": { "type": "string", "description": "Id in the sources registry." },
                "name": { "type": "string", "description": "Inline alternative to a registry id." },
                "type": { "type": "string" },
                "timestamp": { "$ref": "#/$defs/time" },
                "detail": { "type": "string" },
                "link": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
