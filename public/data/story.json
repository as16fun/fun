    "fictional": true,
    "disclaimer": "Fictional demo scenario. The demonstration, times, crowd figures, quotes, people and sources are all invented. Only the street names and the map are real."
  },
  "chapters": [
    {
      "id": "c1",
      "title": "Gathering on the Markt",
      "start": "18:00",
      "summary": "People with bike lights and paper lanterns gather on the Markt. Organisers speak from a small stage at the north end of the square.",
      "camera": {
        "target": [
          5.47852,
          51.43935
        ],
        "zoom": 2.15
      }
    },
    {
      "id": "c2",
      "title": "The march sets off",
      "start": "19:10",
      "summary": "The crowd leaves the Markt heading north along Demer and loops across 18 Septemberplein, then down the Vestdijk.",
      "camera": {
        "target": [
          5.4795,
          51.4404
        ],
        "zoom": 1.55
      }
    },
    {
      "id": "c3",
      "title": "Through Stratumseind",
      "start": "19:45",
      "summary": "Via Ten Hagestraat the march reaches Catharinaplein in front of the church, then heads down Stratumseind towards the Stadhuis.",
      "camera": {
        "target": [
          5.4811,
          51.4368
        ],
        "zoom": 1.7
      }
    },
    {
      "id": "c4",
      "title": "Closures and diversions",
      "start": "20:10",
      "summary": "As the march nears the Stadhuis, the Wal is closed to traffic and buses are diverted along the Vestdijk and Geldropseweg.",
      "camera": {
        "target": [
          5.482,
          51.4362
        ],
        "zoom": 1.12
      }
    },
    {
      "id": "c5",
      "title": "At the Stadhuis",
      "start": "20:30",
      "summary": "The crowd builds up outside the Stadhuis. Organisers and the municipality give very different estimates of its size.",
      "camera": {
        "target": [
          5.4803,
          51.43545
        ],
        "zoom": 2
      }
    },
    {
      "id": "c6",
      "title": "Dispersal and reopening",
      "start": "21:45",
      "summary": "Organisers close the event. People leave in several directions, the Wal reopens and buses return to their normal routes.",
      "camera": {
        "target": [
          5.4802,
          51.4356
        ],
        "zoom": 1.35
      }
    }
