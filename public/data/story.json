    "standfirst": "A fictional march for safer night cycling in Eindhoven, from the Markt to the Stadhuis.",
    "byline": "Storyline Demo Desk",
    "date": "2026-09-25",
    "timezone": "Europe/Amsterdam",
    "start": "18:00",
    "end": "23:00",
